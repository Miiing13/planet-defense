[sub_resource type="GDScript" id="1"]
script/source = "extends Node2D

var way1=[\"路标0\",\"路标2\",\"路标3\",\"路标4\",\"路标5\",\"路标6\",\"路标7\",\"路标8\",\"路标9\",\"路标10\"]

@onready var Incubator=$\"孵化器\"

func GetCoordbyPath(SignGroup):
	var CoordGroup=[]
	for i in SignGroup:
		var node=SceneScheduling.CurrentLevel.get_node(\"路径/\"+i)
		CoordGroup.append(node.position)

	return CoordGroup
	
func _init():
	SceneScheduling.CurrentLevel=self

func _ready():
	GodOfGame.StartLevel(20)
	var WayGroup=GetCoordbyPath(way1)
	Incubator.HatchMonster(\"宇航员\",WayGroup)
	Incubator.HatchMonster(\"飞行器\",WayGroup)
	Incubator.FinishSchedulingWaves()
"

