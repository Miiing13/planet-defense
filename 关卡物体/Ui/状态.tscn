[sub_resource type="GDScript" id=2]
script/source = "extends Control

func _ready():
	GodOfGame.connect(\"HPChange\", Callable(self, \"HPChange\"))
	GodOfGame.connect(\"EXPChange\", Callable(self, \"EXPChange\"))
	HPChange(GodOfGame.HP)
	EXPChange(GodOfGame.EXP)
	
func HPChange(parameter):
	$\"HBoxContainer/生命值\".text=str(parameter)
	
func EXPChange(parameter):
	$\"HBoxContainer/经验值\".text=str(parameter)
"

