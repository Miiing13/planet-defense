var monster1=load(\"res://关卡物体/怪物/怪物1.tscn\")

func HatchOneMonster():
	var MonsterSample=monster1.instance()
	SceneScheduling.CurrentLevel.add_child(MonsterSample)
	var CoordGroup=SceneScheduling.CurrentLevel.GetCoordbyPath(SceneScheduling.CurrentLevel.way1)
	MonsterSample.PathSetting(CoordGroup)


func _on__timeout():
	HatchOneMonster()

