[gd_scene load_steps=3 format=2]

[ext_resource path="res://游戏资源/图片/IMG_2203.PNG" type="Texture" id=1]

[sub_resource type="GDScript" id=1]
script/source = "extends Node2D

var monster1=load(\"res://关卡物体/怪物/怪物1.tscn\")

var MonsterList=[{\"Name\":\"宇航员\",\"Scene\":load(\"res://关卡物体/怪物/怪物1.tscn\"),\"Number\":10,\"HatchedNumber\":0,\"IncubationInterval\":1,\"Timer\":Timer.new()},
				{\"Name\":\"飞行器\",\"Scene\":load(\"res://关卡物体/怪物/怪物1.tscn\"),\"Number\":10,\"HatchedNumber\":0,\"IncubationInterval\":1,\"Timer\":Timer.new()}]

var HatchingOrNot=false

var TaskList=[]

func _ready():
	for i in MonsterList:
		add_child(i.Timer)

func HatchMonster(Name,Way):
	#print(TaskList)
	TaskList.append({\"Name\":Name,\"Way\":Way})

func GetListItemByName(Name):
	for Item in MonsterList:
		if Item[\"Name\"]==Name:
			return Item


var PollingInterval=1
func _physics_process(delta):
	PollingInterval-=delta
	if PollingInterval<=0:
		PollingInterval=1
		if HatchingOrNot==false and TaskList.size()>0:
			var Item=GetListItemByName(TaskList[0].Name)
			Item.Timer.wait_time=Item.IncubationInterval
			Item.Timer.autostart=true
			Item.HatchedNumber=0
			Item.Timer.connect(\"timeout\",self,\"HatchingCallback\",[Item,TaskList[0].Way])
			Item.Timer.start()
			HatchingOrNot=true



func HatchingCallback(Item,CoordGroup):
	var MonsterSample=Item[\"Scene\"].instance()
	SceneScheduling.CurrentLevel.add_child(MonsterSample)
	MonsterSample.PathSetting(CoordGroup)
	Item[\"HatchedNumber\"]+=1
	if Item[\"HatchedNumber\"]>Item[\"Number\"]:
		Item[\"Timer\"].stop()
		TaskList.remove(0)
		HatchingOrNot=false
		
		
		
		
		
		
		
		
		
		
		

"

[node name="Incubator" type="Node2D"]
script = SubResource( 1 )

