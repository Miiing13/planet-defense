[sub_resource type="GDScript" id="1"]
script/source = "extends Node2D

var monster1=load(\"res://关卡物体/怪物/怪物1.tscn\")
# 是否已经确认本关所有波次都安排完毕
var AllWavesScheduled = false

var MonsterList=[{\"Name\":\"宇航员\",\"Scene\":load(\"res://关卡物体/怪物/怪物1.tscn\"),\"Number\":10,\"HatchedNumber\":0,\"IncubationInterval\":1,\"Timer\":Timer.new()},
				{\"Name\":\"飞行器\",\"Scene\":load(\"res://关卡物体/怪物/怪物1.tscn\"),\"Number\":10,\"HatchedNumber\":0,\"IncubationInterval\":1,\"Timer\":Timer.new()}]

var HatchingOrNot=false

var TaskList=[]

func _ready():
	for i in MonsterList:
		add_child(i.Timer)
		i.Timer.connect(\"timeout\", Callable(self, \"HatchingCallback\").bind(i))

func HatchMonster(Name, Way):
	var Item = GetListItemByName(Name)

	if Item == null:
		push_warning(\"找不到怪物类型：\" + Name)
		return

	TaskList.append({
		\"Name\": Name,
		\"Way\": Way
	})

func GetListItemByName(Name):
	for Item in MonsterList:
		if Item[\"Name\"]==Name:
			return Item


var PollingInterval=1
func _physics_process(delta):
	PollingInterval-=delta
	if PollingInterval<=0:
		PollingInterval=1
		if HatchingOrNot==false and TaskList.size()>0:
			var Item=GetListItemByName(TaskList[0].Name)
			Item.Timer.wait_time=Item.IncubationInterval
			Item.Timer.autostart=true
			Item.HatchedNumber=0
			Item.Timer.start()
			HatchingOrNot=true




func HatchingCallback(Item):
	# 如果当前任务已经结束，就停止计时
	if TaskList.is_empty():
		Item[\"Timer\"].stop()
		return

	var MonsterSample = Item[\"Scene\"].instantiate()
	SceneScheduling.CurrentLevel.add_child(MonsterSample)
	MonsterSample.PathSetting(TaskList[0][\"Way\"])

	# 更新统计
	GodOfGame.MonsterSpawned()
	Item[\"HatchedNumber\"] += 1

	# 达到规定数量就结束当前孵化任务
	if Item[\"HatchedNumber\"] >= Item[\"Number\"]:
		Item[\"Timer\"].stop()
		TaskList.remove_at(0)
		HatchingOrNot = false
		CheckLevelSpawningFinished()

# 由关卡管理器在最后一波安排完毕后调用
func FinishSchedulingWaves():
	AllWavesScheduled = true
	CheckLevelSpawningFinished()


# 检查是否所有孵化任务都已经完成
func CheckLevelSpawningFinished():
	if AllWavesScheduled and TaskList.is_empty() and not HatchingOrNot:
		GodOfGame.FinishSpawning()
		
		
		
		
		
		
		
		
		
		
"

