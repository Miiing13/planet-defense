[sub_resource type="GDScript" id=1]
script/source = "extends Node2D

var MoveSpeed=300
var TTL=1
var ATK=3

func _ready():
	$\"计时器\".wait_time=TTL
	$\"计时器\".start()
	
func _process(delta):
	position+=Vector2(0,1).rotated(deg2rad(rotation_degrees))*MoveSpeed*delta

func _on__timeout():
	queue_free()

func _on__area_entered(area):
	damage(ATK,area)
	queue_free()

func damage(value,area):
	print(area)
	var object=area.get_parent()
	if object.has_method(\"Getdamage\"):
		object.Getdamage(value)

"

