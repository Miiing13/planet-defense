script/source = "extends Node2D

var tower1=load(\"res://关卡物体/炮塔/箭塔.tscn\")
var tower2
var BuildableOrNot=true

func _on_NinePatchRect_gui_input(event):
	if Input.is_action_just_pressed(\"左键\"):
		if BuildableOrNot:
			$\"选单\".visible=!$\"选单\".visible
		
func _ready():
	$\"选单\".visible=false
	
func Build():
	add_child(tower1.instance())
	BuildableOrNot=false
	$\"选单\".visible=false
	
	


func _on_1_gui_input(event):
	if Input.is_action_just_pressed(\"左键\"):
		if BuildableOrNot:
			Build()
		

"

