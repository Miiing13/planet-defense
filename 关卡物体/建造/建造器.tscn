[sub_resource type="GDScript" id="1"]
script/source = "extends Node2D

var tower1=load(\"res://关卡物体/炮塔/箭塔.tscn\")
var tower2=load(\"res://关卡物体/炮塔/触手.tscn\")
var tower2Cost=30
var tower1Cost=40
var BuildableOrNot=true

func _ready():
	$\"选单\".visible = false


func _on_NinePatchRect_gui_input(event):
	if event is InputEventMouseButton and event.button_index == MOUSE_BUTTON_LEFT and event.pressed:
		if BuildableOrNot:
			$\"选单\".visible = !$\"选单\".visible


# 建造第一个炮塔
func Build():
	if GodOfGame.EXP >= tower1Cost and BuildableOrNot:
		add_child(tower1.instantiate())
		BuildableOrNot = false
		$\"选单\".visible = false
		GodOfGame.AlterEXP(-tower1Cost)


# 第一个炮塔按钮
func _on_1_gui_input(event):
	if event is InputEventMouseButton and event.button_index == MOUSE_BUTTON_LEFT and event.pressed:
		if BuildableOrNot and GodOfGame.EXP >= tower1Cost:
			Build()


# 建造第二个炮塔
func Build2():
	if GodOfGame.EXP >= tower2Cost and BuildableOrNot:
		add_child(tower2.instantiate())
		BuildableOrNot = false
		$\"选单\".visible = false
		GodOfGame.AlterEXP(-tower2Cost)


# 第二个炮塔按钮
func _on_塔2_gui_input(event):
	if event is InputEventMouseButton and event.button_index == MOUSE_BUTTON_LEFT and event.pressed:
		if BuildableOrNot and GodOfGame.EXP >= tower2Cost:
			Build2()
		
"

