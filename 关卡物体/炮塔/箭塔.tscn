[sub_resource type="GDScript" id=2]
script/source = "extends Node2D

export (PackedScene) var Bullet

var TargetList=[]

func _ready():
	$\"计时器\".stop()

func _on__area_entered(area):
	TargetList.append(area)
	$\"计时器\".start()
	
func _on__area_exited(area):
	TargetList.erase(area)
	
func _on__timeout():
	if TargetList.size()>0:
		ShootTheTarget(TargetList[0].global_position)
	
func ShootTheTarget(Target):
	CreateBullet.CreateBullet(global_position,Target,Bullet)
	
	

"

