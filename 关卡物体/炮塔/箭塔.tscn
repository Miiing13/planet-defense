[sub_resource type="GDScript" id="2"]
script/source = "extends Node2D

@export var Bullet: PackedScene

var TargetList=[]

@export var initial_facing_angle: float = -90

func _ready():
	$\"计时器\".stop()
	$AnimatedSprite2D.play()

func _on__area_entered(area):
	TargetList.append(area)
	$\"计时器\".start()
	
func _on__area_exited(area):
	TargetList.erase(area)
	
func _on__timeout():
	if TargetList.size()>0:
		ShootTheTarget(TargetList[0].global_position)
	
func ShootTheTarget(Target):
	CreateBullet.CreateBullet(global_position,Target,Bullet)
	var player = $AudioStreamPlayer
	if player.stream:
		player.stream.loop = false
		player.play()
		
func _process(delta):
	if TargetList.size() > 0:
		var target_position = TargetList[0].global_position
		var direction = (target_position - global_position).normalized()
		var target_angle = direction.angle()
		rotation = target_angle - deg_to_rad(initial_facing_angle)
	
"

