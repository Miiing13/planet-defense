[sub_resource type="GDScript" id="2"]
script/source = "
extends Node2D

@export var aoe_effect: PackedScene

# AOE 攻击半径
@export var aoe_radius: float = 200.0

# 每次攻击造成的伤害
@export var aoe_damage: float = 1.0

var TargetList = []

func _ready():
	$\"计时器\".stop()
	$AnimatedSprite2D.play()


func _on__area_entered(area):
	if not TargetList.has(area):
		TargetList.append(area)

	if not $\"计时器\".is_stopped():
		return

	$\"计时器\".start()


func _on__area_exited(area):
	TargetList.erase(area)

	if TargetList.is_empty():
		$\"计时器\".stop()


func _on__timeout():
	if TargetList.is_empty():
		$\"计时器\".stop()
		return
	AOEAttack()




func AOEAttack():
	var attacked_targets = []

	# 生成 AOE 攻击特效
	if aoe_effect:
		var effect = aoe_effect.instantiate()
		get_tree().current_scene.add_child(effect)
		effect.global_position = global_position

	# 对攻击范围内的敌人造成伤害
	for target in TargetList.duplicate():
		if not is_instance_valid(target):
			TargetList.erase(target)
			continue

		var distance = global_position.distance_to(
			target.global_position
		)


		if distance <= aoe_radius:
			var enemy = target

# 如果检测到的是 Area2D，尝试获取它的父节点
			if target is Area2D:
				enemy = target.get_parent()

# 判断怪物是否拥有受伤函数
				if enemy.has_method(\"Getdamage\"):
					enemy.Getdamage(aoe_damage)



	# 每次攻击只播放一次音效
	var player = $AudioStreamPlayer
	if player.stream:
		player.play()
"

