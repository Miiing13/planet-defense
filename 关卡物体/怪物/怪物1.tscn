[sub_resource type="GDScript" id=2]
script/source = "extends Node2D

var WalkPath
var CurrentSignIndex
var MovingSpeed=100

func PathSetting(CoordGroup):
	WalkPath=CoordGroup
	CurrentSignIndex=0
	position=WalkPath[CurrentSignIndex]
	
	
func _physics_process(delta):
	print(WalkPath)
	if WalkPath!=null:
		
		var NextIndex=CurrentSignIndex+1
		if NextIndex<WalkPath.size():
			if position.distance_to(WalkPath[NextIndex])>2:
				var MovingDirection:Vector2=WalkPath[NextIndex]-position
				position+=MovingDirection.normalized()*MovingSpeed*delta
			else:
				CurrentSignIndex+=1
				
		

"

