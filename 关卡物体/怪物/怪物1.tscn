[ext_resource type="Texture2D" uid="uid://x3g0c6qb8t0n" path="res://关卡物体/怪物/游戏素材/未命名作品-1.png" id="6"]

[sub_resource type="GDScript" id="2"]
script/source = "extends Node2D

var WalkPath
var CurrentSignIndex
var MovingSpeed = 100
var HP = 12
var MaxHP = 12
var DropEXP = 20

@onready var HealthBarNode = $HealthBarContainer/HealthBar/Progress  # 直接引用 TextureHealthBarNode 节点
@export var 消灭特效: PackedScene
var IsDead = false

func _ready():
	$\"动画\".play()  # 启动走路动画（Godot 4 无 playing 属性，需显式调用 play）
	# 初始化血条
	if HealthBarNode:
		HealthBarNode.min_value = 0
		HealthBarNode.max_value = MaxHP
		HealthBarNode.value = HP
		HealthBarNode.visible = true

func PathSetting(CoordGroup):
	WalkPath = CoordGroup
	CurrentSignIndex = 0
	position = WalkPath[CurrentSignIndex]
	UpdateHealthBar()

func _physics_process(delta):
	if IsDead:
		return
	if WalkPath != null:
		var NextIndex = CurrentSignIndex + 1
		if NextIndex < WalkPath.size():
			if position.distance_to(WalkPath[NextIndex]) > 2:
				var MovingDirection: Vector2 = WalkPath[NextIndex] - position
				position += MovingDirection.normalized() * MovingSpeed * delta
			else:
				CurrentSignIndex += 1
				UpdateHealthBarPosition()
		else:
			Die(true)


func Getdamage(value):
	# 防止怪物死亡后重复受到伤害、重复生成特效
	if IsDead:
		return

	print(\"Monster received damage: \", value)
	HP -= value
	UpdateHealthBar()

	if HP <= 0:
		Die()


func Die(escaped := false):
	IsDead = true
	GodOfGame.MonsterRemoved()
	print(\"Monster is dead\")

	# 停止怪物的走路动画
	$\"动画\".stop()

	# 生成死亡特效
	if 消灭特效:
		var 特效 = 消灭特效.instantiate()
		get_parent().add_child(特效)
		特效.global_position = global_position

	# 发放经验（漏怪不发放）
	if not escaped:
		GodOfGame.AlterEXP(DropEXP)

	# 删除怪物
	queue_free()

func UpdateHealthBar():
	print(\"UpdateHealthBar called\")
	if HealthBarNode:
		print(\"HealthBarNode value before update: \", HealthBarNode.value)
		HealthBarNode.value = HP
		HealthBarNode.max_value = MaxHP
		print(\"HealthBarNode value after update: \", HealthBarNode.value)

func UpdateHealthBarPosition():
	if HealthBarNode:
		# 将血条固定在角色头顶
		HealthBarNode.position = Vector2(-HealthBarNode.size.x / 10,10)
"

