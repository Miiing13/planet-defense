[sub_resource type="GDScript" id="1"]
script/source = "extends Control



func _on_start_gui_input(event):
	if Input.is_action_just_pressed(\"左键\"):
		SceneScheduling.sceneswich(\"res://游戏界面/关卡选择.tscn\")


func _on_setting_gui_input(event):
	if Input.is_action_just_pressed(\"左键\"):
		SceneScheduling.sceneswich(\"res://游戏界面/设置界面.tscn\")

func _on_end_gui_input(event):
	if Input.is_action_just_pressed(\"左键\"):
		get_tree().quit()
"

